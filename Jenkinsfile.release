// The release pipeline: from a `v*` tag, build the `selx` tarball on each
// platform and attach all three, with their checksums, to a GitHub Release
// of that tag.
//
// A second multibranch job points at this file: tags only, with the Tags
// build strategy, a name filter of `v.*` with the regular-expression
// filter (`v*` if the wildcard filter is used instead: the pattern must
// match the filter type), and two string credentials bound:
// `selx-release-token` (a fine-grained GitHub token with contents
// read/write on the repository) and `selx-crates-token` (a crates.io API
// token scoped to publishing `selx`). The branch job (Jenkinsfile)
// discovers branches only, so the two never see the same ref. Each agent
// needs the Rust toolchain and `gh` on PATH. The tag must be `v` + the
// version in Cargo.toml.
//
// All three matrix cells publish to one Release: whichever creates it
// first wins, the others' create is a no-op, and each uploads its own
// files with --clobber. Nothing here deletes a release or an asset, so a
// re-run (the RELEASE_TAG parameter) refreshes the assets in place. The
// crate goes to crates.io last, from the amd64 agent, and only when both
// PUBLISH_CRATES is on and the repository is public; otherwise `cargo
// publish --dry-run` stands in. A crates.io version can never be
// replaced, so a re-run that only refreshes the tarballs must not try
// (PUBLISH_CRATES off), and a crate must not be published while the
// repository its page links to is private (the visibility check), which
// is how a release pipeline is proven before the repository goes public.
pipeline {
    agent none

    options {
        timestamps()
        timeout(time: 40, unit: 'MINUTES')
    }

    parameters {
        string(name: 'RELEASE_TAG', defaultValue: '',
               description: 'Re-run for a tag by hand, e.g. v0.1.0 (normally the tag that triggered the build)')
        booleanParam(name: 'PUBLISH_CRATES', defaultValue: true,
               description: 'Publish the crate to crates.io. Off for a re-run that only refreshes the tarballs: crates.io refuses a version it already has.')
    }

    environment {
        REL_TAG = "${env.TAG_NAME ?: params.RELEASE_TAG}"
        GH_REPO = 'hungryhorace/selx'
        CARGO_TERM_COLOR = 'always'
        CARGO_INCREMENTAL = '0'
    }

    stages {
        stage('Release') {
            matrix {
                axes {
                    axis {
                        name 'PLATFORM'
                        values 'amd64', 'aarch64', 'mac'
                    }
                }
                agent { label "${PLATFORM}" }
                stages {
                    // The tag must be `v` + the Cargo version, or the binary
                    // would report one version and the release another.
                    // Fails before anything is built.
                    stage('Guard') {
                        steps {
                            sh '''
                                ver=$(sed -n 's/^version = "\\(.*\\)"/\\1/p' Cargo.toml | head -1)
                                if [ -z "$REL_TAG" ]; then
                                    echo "No tag: run from a v* tag, or set RELEASE_TAG" >&2
                                    exit 1
                                fi
                                if [ "$REL_TAG" != "v$ver" ]; then
                                    echo "Tag $REL_TAG does not match Cargo.toml version $ver (expected v$ver)" >&2
                                    exit 1
                                fi
                                echo "Releasing $REL_TAG on $(rustc -vV | sed -n 's/^host: //p')"
                            '''
                        }
                    }
                    // A release is built from a tested tree, even though the
                    // branch job tested the same commit before it was
                    // published; it costs a minute.
                    stage('Test') {
                        steps {
                            sh 'cargo test --locked'
                        }
                    }
                    stage('Package') {
                        steps {
                            sh 'scripts/package.sh "$(rustc -vV | sed -n \'s/^host: //p\')"'
                        }
                    }
                    stage('Publish') {
                        steps {
                            withCredentials([string(credentialsId: 'selx-release-token', variable: 'GH_TOKEN')]) {
                                sh '''
                                    gh release create "$REL_TAG" --title "$REL_TAG" --generate-notes || true
                                    gh release upload "$REL_TAG" dist/*.tar.gz dist/*.sha256 --clobber
                                '''
                            }
                        }
                    }
                }
            }
        }
        // One SHA256SUMS over the three tarballs, assembled from the per-file
        // checksums the cells uploaded. A convenience; the .sha256 files
        // already suffice.
        stage('Checksums') {
            agent { label 'amd64' }
            steps {
                withCredentials([string(credentialsId: 'selx-release-token', variable: 'GH_TOKEN')]) {
                    sh '''
                        rm -rf sums && mkdir sums
                        gh release download "$REL_TAG" --pattern '*.sha256' --dir sums
                        cat sums/*.sha256 > sums/SHA256SUMS
                        cat sums/SHA256SUMS
                        gh release upload "$REL_TAG" sums/SHA256SUMS --clobber
                        # The crates stages share this workspace, and `cargo
                        # publish` refuses a tree with untracked files in it.
                        rm -rf sums
                    '''
                }
            }
        }
        // The crate, from the same tested tree, after the tarballs are up:
        // a crates.io failure leaves a complete GitHub Release behind and is
        // fixed by a re-run. `--locked`: the lock file is part of the tree.
        // First the repository's visibility, which decides between the two
        // stages that follow; it is read into the environment here because
        // `when` cannot run a shell step of its own.
        stage('Crates (check)') {
            agent { label 'amd64' }
            steps {
                withCredentials([string(credentialsId: 'selx-release-token', variable: 'GH_TOKEN')]) {
                    script {
                        env.REPO_VISIBILITY = sh(returnStdout: true,
                            script: 'gh api "repos/$GH_REPO" --jq .visibility').trim()
                    }
                }
                sh 'echo "repository is $REPO_VISIBILITY; PUBLISH_CRATES=$PUBLISH_CRATES"'
            }
        }
        stage('Crates (dry run)') {
            when {
                not { allOf {
                    expression { params.PUBLISH_CRATES }
                    environment name: 'REPO_VISIBILITY', value: 'public'
                } }
            }
            agent { label 'amd64' }
            steps {
                sh 'cargo publish --locked --dry-run'
            }
        }
        stage('Crates') {
            when {
                allOf {
                    expression { params.PUBLISH_CRATES }
                    environment name: 'REPO_VISIBILITY', value: 'public'
                }
            }
            agent { label 'amd64' }
            steps {
                withCredentials([string(credentialsId: 'selx-crates-token', variable: 'CARGO_REGISTRY_TOKEN')]) {
                    sh 'cargo publish --locked'
                }
            }
        }
    }
}
